#!/bin/bash
# PK Voice Cloner — démarre ou arrête uniquement son propre serveur local.
PROJET="$HOME/Documents/GitHub/PROJECTS/Macos_PKvoicecloner"
URL="http://127.0.0.1:8809"
LOG="$PROJET/data/logs/serveur.log"
PID_FILE="$PROJET/data/run/serveur.pid"
mkdir -p "$(dirname "$LOG")" "$(dirname "$PID_FILE")"

serveur_actif() {
  curl -s --max-time 2 "$URL/api/etat" >/dev/null 2>&1
}

est_notre_serveur() {
  local pid="${1:-}"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 1
  local commande
  commande="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  [[ "$commande" == *"$PROJET/app/serveur.py"* ]]
}

pid_serveur() {
  local pid
  if [ -r "$PID_FILE" ]; then
    pid="$(cat "$PID_FILE")"
    if est_notre_serveur "$pid"; then
      printf '%s\n' "$pid"
      return 0
    fi
  fi
  for pid in $(lsof -tiTCP:8809 -sTCP:LISTEN 2>/dev/null); do
    if est_notre_serveur "$pid"; then
      printf '%s\n' "$pid"
      return 0
    fi
  done
  return 1
}

notifier() {
  osascript -e "display notification \"$1\" with title \"PK Voice Studio\"" >/dev/null 2>&1
}

arreter_serveur() {
  if curl -s --fail --max-time 2 -X POST "$URL/api/arreter" >/dev/null 2>&1; then
    for _ in $(seq 1 20); do
      if ! serveur_actif; then
        rm -f "$PID_FILE"
        notifier "Studio arrêté — le modèle a été libéré."
        exit 0
      fi
      sleep 0.25
    done
  fi

  local pid
  if ! pid="$(pid_serveur)"; then
    rm -f "$PID_FILE"
    notifier "Aucun studio local en cours."
    exit 0
  fi

  kill -TERM "$pid"
  for _ in $(seq 1 20); do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$PID_FILE"
      notifier "Studio arrêté — le modèle a été libéré."
      exit 0
    fi
    sleep 0.25
  done
  kill -KILL "$pid" 2>/dev/null || true
  rm -f "$PID_FILE"
  notifier "Studio forcé à l'arrêt — le modèle a été libéré."
}

if [ "${1:-}" = "--stop" ]; then
  arreter_serveur
  exit 0
fi

if ! serveur_actif; then
  export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
  nohup "$PROJET/.venv/bin/python" "$PROJET/app/serveur.py" >> "$LOG" 2>&1 &
  for _ in $(seq 1 90); do
    serveur_actif && break
    sleep 1
  done
  notifier "Le serveur local est démarré."
fi
open "$URL"
